{
    // =====================================================
    // DCA 调试配置 - CPU版本
    // 适合: 快速测试、调试、学习代码逻辑
    // 特点: 少量智能体、少量线程、CPU运行
    // =====================================================

    "config.py->GlobalConfig": {
        "note": "dca_debug_cpu",        // 实验名称
        "env_name": "dca",               // DCA单队环境
        "env_path": "MISSION.dca",
        "draw_mode": "Img",

        // 运行配置
        "num_threads": 8,                // 8个并行环境 (快速启动)
        "device": "cpu",                 // 使用CPU
        "fold": 1,                       // 进程数

        // 训练配置
        "n_parallel_frame": 1000000,     // 总帧数 (约100万)
        "max_n_episode": 5000,           // 最大episode数
        "seed": 12345,

        // 测试配置
        "report_reward_interval": 8,     // 每8个episode报告一次
        "test_interval": 100,            // 每100个episode测试一次
        "test_epoch": 16,                // 测试16个episode
        "train_time_testing": true,

        "backup_files": [
            "ALGORITHM/conc_4hist",
            "MISSION/dca"
        ]
    },

    "MISSION.dca.collective_assault_parallel_run.py->ScenarioConfig": {
        // 环境参数
        "size": 5,
        "MaxEpisodeStep": 100,           // 100步结束 (快速)

        // 智能体数量
        "num_guards": 10,                // 10个RL守卫
        "num_attackers": 12,             // 12个脚本AI攻击者

        // 物理参数
        "agent_acc": 3.0,
        "agent_max_speed": 1.0,
        "agent_max_rot": 0.17,

        // 环境特性
        "random_jam_prob": 0.0,          // 无干扰
        "introduce_terrain": false,      // 无地形
        "init_distance": 4,

        // 渲染
        "render": true,                  // 启用渲染观察行为

        // 奖励
        "half_death_reward": true,
        "REWARD_DEBUG": false,

        // 算法
        "TEAM_NAMES": [
            "ALGORITHM.conc_4hist.foundation->ReinforceAlgorithmFoundation"
        ]
    },

    "ALGORITHM.conc_4hist.foundation.py->AlgorithmConfig": {
        "train_traj_needed": 8,          // 少量轨迹快速更新
        "n_focus_on": 3,
        "lr": 0.001,                     // 较大学习率
        "ppo_epoch": 16,
        "gamma": 0.99,
        "load_checkpoint": false
    }
}
